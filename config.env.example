# Copy to config.env (gitignored) and adjust. Every script in scripts/ sources it.

# GitHub repo that Argo CD syncs from and where demo PRs are opened.
GITHUB_REPO=pfischer8989/ocp-virt-gitops-migration
REPO_URL=https://github.com/${GITHUB_REPO}.git
REPO_BRANCH=main

# Only needed if the GitHub repo is PRIVATE. A fine-grained token with
# read-only "Contents" access to this repo. Used by Argo CD and AAP to clone.
# Leave empty for a public repo.
REPO_TOKEN=

# Argo CD
GITOPS_NAMESPACE=openshift-gitops

# MTV
MTV_NAMESPACE=openshift-mtv

# Ansible Automation Platform
AAP_NAMESPACE=aap
AAP_ROUTE=aap                      # gateway route name in $AAP_NAMESPACE
AAP_ADMIN_USER=admin
AAP_ADMIN_PASSWORD_SECRET=aap-admin-password
AAP_ORG=Default
# Credentials that already exist in the lab's AAP (created by the lab install).
AAP_KUBE_CREDENTIAL="kubeconfig"
AAP_VMWARE_CREDENTIAL="VMware Credentials"
