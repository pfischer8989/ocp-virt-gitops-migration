# Only needed if the GitHub repo is PRIVATE.
# scripts/bootstrap.sh creates this automatically from REPO_TOKEN in config.env;
# this file documents the shape. Never commit the filled-in copy.
apiVersion: v1
kind: Secret
metadata:
  name: ocp-virt-gitops-migration-repo
  namespace: openshift-gitops
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/pfischer8989/ocp-virt-gitops-migration.git
  username: git
  password: <github fine-grained token, Contents: read-only>
